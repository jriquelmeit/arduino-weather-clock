#pragma once

#include <Arduino.h>

// ==========================================
// CONFIGURACIÓN DE RED WI-FI (2.4 GHz)
// ==========================================
#define WIFI_SSID       "TU_RED_WIFI_2.4GHZ"
#define WIFI_PASSWORD   "TU_PASSWORD"

// ==========================================
// PINES DE PANTALLA TFT ILI9341 (SPI)
// ==========================================
// Mapeo probado en Lolin NodeMCU V3:
//   TFT_CS   -> D8 (GPIO15)
//   TFT_DC   -> D3 (GPIO0)
//   TFT_RST  -> D4 (GPIO2 / LED_BUILTIN)
//   TFT_MOSI -> D7 (GPIO13 / HSPI MOSI)
//   TFT_CLK  -> D5 (GPIO14 / HSPI SCK)
//   TFT_MISO -> D6 (GPIO12 / Opcional)
//   VCC      -> VIN (5V) o 3V3
//   LED      -> 3V3
//   GND      -> GND
#define TFT_CS          D8
#define TFT_DC          D3
#define TFT_RST         D4
#define TFT_ROTATION    3   // 3: Horizontal 320x240 (con pines arriba a la izquierda)

// ==========================================
// UBICACIÓN Y ZONA HORARIA
// ==========================================
#define LOCATION_NAME   "Santiago"
#define LOCATION_LAT    "-33.4489"
#define LOCATION_LON    "-70.6693"

// Regla POSIX para cambio automático de horario:
// Chile Continental:
// Horario de Invierno: UTC-4 (CLT)
// Horario de Verano:   UTC-3 (CLST), inicia 1er domingo septiembre a medianoche, termina 1er domingo abril a medianoche.
#define TIMEZONE_RULE   "CLT4CLST,M9.1.0/0,M4.1.0/0"

// Servidores NTP
#define NTP_SERVER_1    "pool.ntp.org"
#define NTP_SERVER_2    "time.google.com"

// ==========================================
// INTERVALOS DE ACTUALIZACIÓN
// ==========================================
#define CLOCK_REFRESH_INTERVAL_MS    1000UL          // 1 segundo
#define WEATHER_REFRESH_INTERVAL_MS  (15UL * 60UL * 1000UL) // 15 minutos
#define WEATHER_RETRY_INTERVAL_MS    (60UL * 1000UL) // 1 minuto si falla

// ==========================================
// VISTA / PÁGINA DE PANTALLA
// ==========================================
// 1: Página 1 (Por defecto) - Reloj + Clima actual + Pronóstico 2 días
// 2: Página 2               - Reloj + Clima actual + Pronóstico próximas horas
// 3: Página 3               - Temporizador / Timer
#define DISPLAY_PAGE_MODE            1

// Para Página 2 (Pronóstico por horas): intervalo de horas entre predicciones
// 1 = cada 1 hora (+1h, +2h, +3h, +4h)
// 2 = cada 2 horas (+2h, +4h, +6h, +8h)
// 3 = cada 3 horas (+3h, +6h, +9h, +12h)
#define HOURLY_FORECAST_STEP         2

// ==========================================
// PINES DE BOTONES Y BUZZER
// ==========================================
// Conexión a GND directo (usan INPUT_PULLUP interno)
#define PIN_BTN_PREV                 D1    // GPIO5 - Página anterior
#define PIN_BTN_NEXT                 D2    // GPIO4 - Página siguiente
#define PIN_BTN_ACTION               D6    // GPIO12 - Botón Acción / Timer / Sleep (SDO/MISO del TFT debe estar desconectado)
#define PIN_BUZZER                   D0    // GPIO16 - Buzzer de alarma
#define BUZZER_KEY_BEEP              false // true: beep al pulsar botones | false: solo alarma de temporizador

// ==========================================
// CONFIGURACIÓN DEL TEMPORIZADOR (PÁGINA 3)
// ==========================================
#define TIMER_DEFAULT_MINUTES        5
#define TIMER_MIN_MINUTES            5
#define TIMER_MAX_MINUTES            60
#define TIMER_STEP_MINUTES           5
#define TIMER_LONG_PRESS_MS          1000UL  // Tiempo para confirmar e iniciar (1s)
#define TIMER_ALARM_DURATION_MS      30000UL // Duración máxima alarma buzzer (30s)

// ==========================================
// MODO NOCHE / APAGADO DE PANTALLA PROGRAMADO
// ==========================================
#define NIGHT_MODE_ENABLED           false   // true para activar apagado nocturno automático
#define NIGHT_MODE_START_HOUR        23      // 23:00 (11 PM)
#define NIGHT_MODE_END_HOUR          7       // 07:00 (7 AM)
#define NIGHT_MODE_WAKE_TIMEOUT_MS   30000UL // Tiempo que permanece encendida si se despierta de noche
